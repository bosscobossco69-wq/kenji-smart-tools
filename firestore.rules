rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may read only their own account/trial summary.
    // All writes to trial, subscription, payment, and credit fields are server-only.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Deny all other client access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
